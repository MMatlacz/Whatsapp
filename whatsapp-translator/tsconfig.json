{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "main.ts",
    "preload.ts",
    "src/**/*.ts",
    "renderer/**/*.ts",
    "test/**/*.ts"
  ]
}